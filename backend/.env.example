# App
APP_NAME="AI Virtual Studio"
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
FRONTEND_ORIGIN=http://localhost:3000

# Security
SECRET_KEY=change-me-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
DATABASE_URL=postgresql+psycopg2://studio:studio@localhost:5432/studio

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

# Object storage (S3-compatible). Leave empty to use local disk in dev.
S3_ENDPOINT_URL=
S3_BUCKET=studio-media
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
LOCAL_STORAGE_DIR=./_storage

# AI providers. IMAGE_AI_PROVIDER: "mock" | "gemini" | "replicate".
IMAGE_AI_PROVIDER=gemini
# Google Gemini (free tier, no credit card) — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# Replicate (alternative) — set IMAGE_AI_API_KEY to your Replicate token.
IMAGE_AI_API_KEY=
IMAGE_AI_TRYON_MODEL=cuuupid/idm-vton
IMAGE_AI_MODEL=black-forest-labs/flux-schnell
IMAGE_AI_TIMEOUT=120
VIDEO_AI_PROVIDER=mock
VIDEO_AI_API_KEY=

# Credits
FREE_SIGNUP_CREDITS=30
